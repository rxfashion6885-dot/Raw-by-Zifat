{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Apparel item available in the RAW BY ZIFAT store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "sku": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "description": { "type": "string" },
        "shortDescription": { "type": "string" },
        "images": { "type": "array" },
        "thumbnail": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "material": { "type": "string" },
        "gsm": { "type": "number" },
        "codAvailable": { "type": "boolean" },
        "tiktokReviewUrl": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isOffer": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "slug", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Apparel category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "displayOrder": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "orderStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "phone", "total"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Store configuration and global settings",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public clothing catalog items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders placed by customers"
    },
    "/settings/store": {
      "schema": "SiteSettings",
      "description": "Global store settings"
    }
  }
}
